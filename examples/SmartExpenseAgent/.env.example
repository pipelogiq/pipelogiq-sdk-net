# ─── Pipelogiq ────────────────────────────────────────────────────────────────
# API key from your Pipelogiq workspace (Settings → API Keys)
PIPELOGIQ_API_KEY=your-pipelogiq-api-key-here

# External API URL exposed by pipelogiq-app (:8081)
# Inside the pipelogiq Docker network → use the service name:
PIPELOGIQ_API_URL=http://pipelogiq-app:8081
# If Pipelogiq is running locally (not in Docker) → use:
# PIPELOGIQ_API_URL=http://host.docker.internal:8081

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Token from @BotFather  →  /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# ─── Optional overrides ───────────────────────────────────────────────────────
# LOG_LEVEL=Information
# DOTNET_ENVIRONMENT=Production
