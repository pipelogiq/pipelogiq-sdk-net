  <ItemGroup>
    <ProjectReference Include="..\Pipelogiq.Sdk\PipelogiqSDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
