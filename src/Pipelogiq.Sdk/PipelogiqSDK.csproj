<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>PipelogiqSDK</PackageId>
    <Description>.NET worker runtime and API client for Pipelogiq — define pipelines, run stage handlers, and report results with retries, leases, idempotency and W3C trace propagation.</Description>
    <PackageTags>pipelogiq;workflow;orchestration;pipeline;worker;opentelemetry</PackageTags>
    <PackageProjectUrl>https://github.com/pipelogiq/pipelogiq-sdk-net</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
